# Copy this file to .env after extracting the public ZIP. Never publish .env.
# start.sh generates WINE_ADMIN_PASSWORD on first launch if it is absent.
# WINE_ADMIN_PASSWORD=choose-a-long-random-password

# GigaChat is optional at startup. Without these values the assistant uses
# catalogue-backed recommendations; the scanner and all other features run.
# WINE_GIGACHAT_AUTH_KEY=your-authorization-key
# WINE_GIGACHAT_CLIENT_ID=your-client-id
# WINE_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# WINE_ASSISTANT_MODEL=GigaChat-2
# WINE_ASSISTANT_VISION_MODEL=GigaChat-2-Pro
# WINE_GIGACHAT_CA_BUNDLE=/path/to/trusted-root-ca.pem

# Optional bearer token if your RunPod proxy requires one.
# WINE_ML_API_KEY=your-token
